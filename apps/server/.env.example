# Copy to .env and fill in. See infrastructure/config/settings.py and
# infrastructure/providers/anthropic_http_client.py.

# Auth for every Anthropic Messages API call (classification, OCR
# extraction, document-type config proposals) — set exactly one of these two.
# Both are unprefixed on purpose: read directly from the process environment.
# See infrastructure/providers/anthropic_http_client.py.

# Option A — reuse your Claude Code / subscription auth instead of a billed
# API key. Requests are sent with the Claude Code identifying system block
# prepended, since the API only accepts this token with that block present.
CLAUDE_CODE_OAUTH_TOKEN=

# Option B — a standard, billed Anthropic API key. Takes over if
# CLAUDE_CODE_OAUTH_TOKEN is unset.
ANTHROPIC_API_KEY=

# Claude model used for the calls above.
ACCOUNTANT_ANTHROPIC_MODEL=claude-sonnet-5

# Path to a Google service account JSON key with Drive read access, shared
# with the Drive folder(s) documents get uploaded to.
ACCOUNTANT_GOOGLE_SERVICE_ACCOUNT_FILE=

# Shared secret used to validate incoming Drive push notifications.
ACCOUNTANT_GOOGLE_DRIVE_WEBHOOK_SECRET=
