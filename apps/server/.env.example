# Copy to .env and fill in. See infrastructure/config/settings.py and
# infrastructure/providers/anthropic_http_client.py.

# Claude Code OAuth token used to authenticate every Anthropic Messages API
# call (classification, OCR extraction, document-type config proposals) —
# reuses your Claude Code / subscription auth instead of a billed API key.
# Unprefixed on purpose: read directly from the process environment.
CLAUDE_CODE_OAUTH_TOKEN=

# Claude model used for the calls above.
ACCOUNTANT_ANTHROPIC_MODEL=claude-sonnet-5

# Path to a Google service account JSON key with Drive read access, shared
# with the Drive folder(s) documents get uploaded to.
ACCOUNTANT_GOOGLE_SERVICE_ACCOUNT_FILE=

# Shared secret used to validate incoming Drive push notifications.
ACCOUNTANT_GOOGLE_DRIVE_WEBHOOK_SECRET=
