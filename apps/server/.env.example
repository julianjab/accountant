# Copy to .env and fill in. See infrastructure/config/settings.py and
# infrastructure/providers/anthropic_http_client.py.

# Auth for every Anthropic Messages API call (classification, OCR
# extraction, document-type config proposals) — set one of these two. Both
# are unprefixed on purpose: read directly from the process environment.
# See infrastructure/providers/anthropic_http_client.py::get_auth_mode.

# Preferred — a standard, billed Anthropic API key. Wins if both are set;
# this is the right choice for a server (billed and revocable on its own,
# independent of anyone's personal Claude Code subscription).
ANTHROPIC_API_KEY=

# Fallback for local development only, when no API key is configured yet —
# reuses your Claude Code / subscription auth. Requests are sent with the
# Claude Code identifying system block prepended, since the API only
# accepts this token with that block present. Ignored if ANTHROPIC_API_KEY
# is set.
CLAUDE_CODE_OAUTH_TOKEN=

# Claude model used for the calls above.
ACCOUNTANT_ANTHROPIC_MODEL=claude-sonnet-5

# Path to a Google service account JSON key with Drive read access, shared
# with the Drive folder(s) documents get uploaded to.
ACCOUNTANT_GOOGLE_SERVICE_ACCOUNT_FILE=

# Shared secret used to validate incoming Drive push notifications.
ACCOUNTANT_GOOGLE_DRIVE_WEBHOOK_SECRET=

# --- Google login (authorization-code flow) ---
# From the same "Web application" OAuth client used by the web app. The redirect
# URI must be registered on that client verbatim, under "Authorized redirect URIs".
ACCOUNTANT_GOOGLE_OAUTH_CLIENT_ID=
ACCOUNTANT_GOOGLE_OAUTH_CLIENT_SECRET=
ACCOUNTANT_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Origin of the web app: where the callback sends the browser once the session
# is established, and the only origin allowed to call this API with credentials.
ACCOUNTANT_WEB_APP_URL=http://localhost:3000

# Set to true when serving over HTTPS so the session cookie is marked Secure.
ACCOUNTANT_SESSION_COOKIE_SECURE=false

# --- Firestore persistence ---
# Project holding clients, documents, document types, extracted data and
# sessions. Leave empty to fall back to in-memory repositories (everything is
# lost on restart). Credentials come from Application Default Credentials
# (GOOGLE_APPLICATION_CREDENTIALS or `gcloud auth application-default login`).
ACCOUNTANT_FIRESTORE_PROJECT=
ACCOUNTANT_FIRESTORE_DATABASE=(default)
